# Damka.uz V2 backend — copy to `.env` and fill in. Defaults are for LOCAL dev;
# the inline "prod:" notes say what to change for production. DevOps only edits
# this file — everything else (workers, static, migrations) is automatic.

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production      # prod: a strong 50+ char random key
DJANGO_DEBUG=True                              # prod: False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1       # prod: cp.damka.uz
DJANGO_SETTINGS_MODULE=config.settings.local   # prod: config.settings.production
# prod only (comma-separated, with scheme):
DJANGO_CSRF_TRUSTED_ORIGINS=https://cp.damka.uz,https://damka.uz
DJANGO_SECURE_SSL_REDIRECT=True                # prod: True (TLS on host nginx)
# Leave BLANK — the app auto-scales uvicorn workers to the server's CPUs in prod.
WEB_CONCURRENCY=

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/damka_v2
POSTGRES_DB=damka_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres                     # prod: a strong password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CONN_MAX_AGE=60                                # reuse DB connections (keep < max_connections)

# ── Redis / Celery ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0             # prod: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1     # prod: redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1 # prod: redis://redis:6379/0

# ── CORS (frontend origins) ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # prod: https://damka.uz

# ── SMS (Eskiz) ───────────────────────────────────────────────────────────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546                                # your registered Eskiz sender
ESKIZ_MESSAGE=Damka.uz tasdiqlash kodi: {code} # must match an Eskiz-approved template
# TEMPORARY: True → code is always 0000 and NO real SMS/email is sent (test the
# flow before Eskiz is live). Turn OFF for a real product.
SMS_TEST_MODE=False

# ── Email (SMTP) ──────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  # prod: ...smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Telegram (optional notifications) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Test admin (migration 0003_test_admin) ────────────────────────────────
TEST_ADMIN_PASSWORD=admin12345                 # prod: change, or delete that admin
