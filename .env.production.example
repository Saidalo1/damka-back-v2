# ── Production .env template for damka-back-v2 ────────────────────────────────
# Copy to `.env` ON THE SERVER and fill in real values. NEVER commit the real .env.
# The same docker-compose.yml is used for prod — it's this file that flips it.

# Django ----------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-generate-a-strong-50char-random-key
# Domains that serve the API/WS (no scheme). Add the server IP too if used.
DJANGO_ALLOWED_HOSTS=cp.damka.uz
# Full origins (with scheme) allowed to POST to the API/admin.
DJANGO_CSRF_TRUSTED_ORIGINS=https://cp.damka.uz,https://damka.uz
# nginx terminates TLS and forwards X-Forwarded-Proto; keep redirect on.
DJANGO_SECURE_SSL_REDIRECT=True
# Multi-worker ASGI (compose/django/start picks uvicorn when > 1). ~= vCPUs.
WEB_CONCURRENCY=4

# Frontend origins (Nuxt) allowed for CORS.
CORS_ALLOWED_ORIGINS=https://damka.uz,https://www.damka.uz

# Database --------------------------------------------------------------------
DATABASE_URL=postgres://damka:STRONG_DB_PASSWORD@postgres:5432/damka_v2
POSTGRES_DB=damka_v2
POSTGRES_USER=damka
POSTGRES_PASSWORD=STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Reuse connections across queries (see base.py). Keep < Postgres max_connections.
CONN_MAX_AGE=60

# Redis / Celery --------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# SMS (Eskiz) -----------------------------------------------------------------
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_MESSAGE=Damka.uz tasdiqlash kodi: {code}
# TEMPORARY: True → verification code is forced to 0000 and no real SMS/email is
# sent, so you can test registration before Eskiz/SMTP are live. Turn OFF for real.
SMS_TEST_MODE=True

# Email (SMTP) ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Telegram (optional notifications) -------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Test admin migration (apps/users/migrations/0003_test_admin) ----------------
# Set a strong password here; or remove that admin after creating your real one.
TEST_ADMIN_PASSWORD=change-me
